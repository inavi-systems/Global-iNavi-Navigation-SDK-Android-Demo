<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/inv_app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".view.MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="com.inavi.navisdk.appkey"
            android:value="YOUR_APP_KEY"/>

        <!-- Map -->
        <activity
            android:name=".view.map.InvMapFragmentActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:description="@string/inv_description_map_fragment"
            android:label="@string/inv_map_fragment">
            <meta-data
                android:name="@string/inv_category"
                android:value="@string/inv_category_map_mode" />
        </activity>

        <!-- Shape -->
        <activity
            android:name=".view.shape.InvMarkerActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:description="@string/inv_description_map_marker"
            android:label="@string/inv_map_marker">
            <meta-data
                android:name="@string/inv_category"
                android:value="@string/inv_category_map_mode" />
        </activity>

        <!-- Camera -->
        <activity
            android:name=".view.camera.InvCameraMoveActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:description="@string/inv_description_map_camera"
            android:label="@string/inv_map_camera">
            <meta-data
                android:name="@string/inv_category"
                android:value="@string/inv_category_map_mode" />
        </activity>

    </application>

</manifest>